                             A       59 	
                             A       60 	org 2eh
                             A       61 ;put this code in high ROM
0000002E                     A       62 serboot:
                             A       63 ;boot strap from the serial port
0000002E ED 38 C8            A       64 	in0 a,(RxData)	;discard first character read
00000031                     A       65 serboot1:
00000031 ED 38 C4            A       66 	in0 a,(RxStat)	;read status
00000034 E6 80               A       67 	and 080h		;data ready flag is in D[0]; rla also work, save a byte
00000036 28 F9               A       68 	jr z,serboot1
00000038                     A       69 getser:
00000038 ED 38 C8            A       70 	in0 a,(RxData)	;read data
0000003B 77                  A       71 	ld (hl),a		;save program
0000003C 2C                  A       72 	inc l
0000003D 20 F2               A       73 	jr nz,serboot1	;read 256 bytes
0000003F E9                  A       74 	jp (hl)		;same as jp 0a000h
                             A       75 
                             A       76 	end
                             A       77 
